[Unit]
Description=Polymarket copy bot health report (no trading or automatic restart)
After=polymarket-bot.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/polymarket-deploy/releases/RELEASE
ExecStart=/root/polymarket-deploy/releases/RELEASE/.venv/bin/python scripts/check_bot_health.py --output /root/polymarket-copy-trading-bot/logs/health_latest.json
